# LocalPulse AI - Server Environment Configuration

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Leave empty or unset to automatically run in standalone demo/in-memory mode!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/localpulse?retryWrites=true&w=majority

# Google Gemini API Key
# If omitted or invalid, LocalPulse automatically operates with realistic simulated AI inference
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Demo Mode Configuration
ENABLE_DEMO_FALLBACK=true
DEMO_BUSINESS_NAME=The Spice Garden Bistro
